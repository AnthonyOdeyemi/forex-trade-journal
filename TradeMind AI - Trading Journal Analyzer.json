    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst entry = parseFloat($json.entry);\nconst sl = parseFloat($json.sl);\nconst tp = parseFloat($json.tp);\n\nconst risk = Math.abs(entry - sl);\nconst reward = Math.abs(tp - entry);\n\nconst rr = reward / risk;\n\nreturn {\n  json: {\n    ...$json,\n    risk: risk.toFixed(5),\n    reward: reward.toFixed(5),\n    riskRewardRatio: rr.toFixed(2)\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -784,
        -384
      ],
      "id": "b6b860d5-a999-464c-869a-1eb4282a7dcc",
      "name": "Calculate Risk Metrics"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Currency Pair: {{$json.pair}}\n\nTrade Type: {{$json.tradeType}}\n\nEntry Price: {{$json.entry}}\n\nStop Loss: {{$json.sl}}\n\nTake Profit: {{$json.tp}}\n\nRisk Reward Ratio: {{$json.riskRewardRatio}}\n\nTrade Outcome: {{$json.outcome}}\n\nTrader Emotion: {{$json.emotion}}\n\nReason:\n{{$json.reason}}",
        "options": {
          "systemMessage": "You are an elite Forex trading psychologist and risk management analyst.\n\nAnalyze the submitted trade carefully.\n\nEvaluate:\n- Risk management\n- Emotional discipline\n- Trade reasoning\n- Risk-to-reward ratio\n\nKeep responses concise and professional.\n\nReturn ONLY valid JSON:\n\n{\n  \"score\": 0,\n  \"strengths\": \"\",\n  \"weaknesses\": \"\",\n  \"advice\": \"\"\n}\n\nIMPORTANT:\n- Maximum 2 strengths\n- Maximum 2 weaknesses\n- Maximum 2 concise advice points\n- Keep each point under 25 words\n\nKeep feedback concise and actionable. Limit each section to 2 short points maximum.\n\nReturn the trade score strictly as a whole number from 0 to 10.\nExamples:\n0 = extremely poor trade\n5 = average trade\n10 = exceptional trade\n\nNever return percentages or values above 10."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -832,
        -48
      ],
      "id": "7d5a8076-6a8f-43f0-8c94-dbd0365db24d",
      "name": "AI Trade Analysis Engine",
      "retryOnFail": true
    },
